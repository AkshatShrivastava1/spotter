# Copy to .env. With no key, Spotter runs in offline "mock" mode (built-in food DB, template coaching).
SPOTTER_ANTHROPIC_API_KEY=
SPOTTER_LLM_PROVIDER=auto

# Local dev uses SQLite. In the cloud, set DATABASE_URL (postgres://...) and it takes over.
SPOTTER_DATABASE_URL=sqlite:///./spotter.db
# DATABASE_URL=postgres://user:pass@host:5432/dbname

SPOTTER_SCHEDULER_ENABLED=true
SPOTTER_NUDGE_INTERVAL_MINUTES=15
# Enables POST /internal/run-nudges for an external cron. Leave empty locally.
SPOTTER_CRON_SECRET=
SPOTTER_UPLOADS_DIR=uploads
# Signs login tokens. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SPOTTER_JWT_SECRET=
